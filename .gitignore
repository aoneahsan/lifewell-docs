# Dependencies
/node_modules

# Yarn 4 (using node-modules linker, but ignore caches/state regardless)
.yarn/cache
.yarn/install-state.gz
.yarn/build-state.yml
.pnp.*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Production
/build

# Generated files
.docusaurus
.cache-loader

# Editor / IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Env (PUBLIC repo — never track real env files; keep templates)
.env
.env.*
!.env.example
!.env.sample
!.env.template

# Secrets / signing material (PUBLIC repo — never track)
*.jks
*.keystore
key.properties
keystore.properties
*service-account*.json
.npmrc

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Custom (per global rules)
*.ignore.*
project-record-ignore/
